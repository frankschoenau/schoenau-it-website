# Umgebung des Health Checks — nur serverseitig.
#
# Alle Werte hier werden ausschliesslich in Route Handlers und Server
# Components gelesen. Kein `NEXT_PUBLIC_` davor: sobald ein Wert in ein
# ausgeliefertes Bundle gerät, steht das Inhaber-Token in jedem Browser.
#
# Lokal: .env.local anlegen (ist in .gitignore).
# Vercel: Settings -> Environment Variables, fuer Production und Preview.

# ---------- Analyse-API ----------

# Wohin der Durchreicher zeigt. Ohne abschliessenden Schraegstrich.
AAHC_API_BASE_URL=https://api.schoenau-it.de

# Der Token, dessen SHA-256-Digest in AAHC_API_CREDENTIALS auf dem VPS steht.
# Erzeugen und ablegen: siehe digi_prod/deploy/vps/README.md, Abschnitt 5.
AAHC_API_TOKEN=

# NUR DIENSTSEITIG. Mandant fuer Aufrufe OHNE Benutzeridentitaet (z. B. /health).
#
# Kundenbezogene Aufrufe (Assessments, Checks, Analysen, Berichte) senden diesen
# Wert NICHT: dort schickt die Website eine Benutzerassertion, und die API liest
# den Mandanten ausschliesslich aus web.account (AP-04.31 B-1 / AP-04.32).
#
# Der Wert muss in der Allowlist des Dienst-Credentials stehen
# (AAHC_API_CREDENTIALS auf dem VPS). Dort ist der Bootstrap-Mandant
# `aahc-default` gebunden — ein anderer Wert ergibt 403 API_TENANT_MISMATCH.
# Nie aus dem Browser setzen.
AAHC_TENANT_REF=aahc-default

# ---------- Konten (ueber die Python-API) ----------

# Kein PostgreSQL in dieser Anwendung. Identitaet und Sitzungen liegen in der
# AAHC-API; die Website ruft sie serverseitig auf (ADR-018).

# Dasselbe HS256-Geheimnis wie in /srv/ai-server/aahc-prod/api.env.
# Mindestens 32 Byte. Niemals in ein Browser-Bundle.
AAHC_IDENTITY_SECRET=
AAHC_IDENTITY_ISSUER=aahc-web
AAHC_IDENTITY_AUDIENCE=aahc-api

# Basisadresse fuer Links in Mails (Bestaetigung, spaeter Passwort-Reset).
# Ohne diese Angabe wird der Host der Anfrage genommen — hinter einem Proxy
# ist das der falsche, und der Link in der Mail waere unbrauchbar.
APP_BASE_URL=https://www.schoenau-it.de

# ---------- Mail ----------

# Solange leer, landet jede Mail im Server-Log (siehe src/lib/auth/mail.ts).
# Fuer echten Versand: smtps://benutzer:passwort@host:465
SMTP_URL=
